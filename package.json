{
  "name": "my-money-management",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --localhost",
    "android": "node scripts/start-android.cjs",
    "test": "node --test --test-concurrency=2 \"tests/*.test.cjs\" \"scripts/companion/tests/*.test.cjs\" \"tools/auth-emulator/tests/*.test.cjs\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck",
    "test:python": "python scripts/companion/tests/test_helpers.py && python tools/auth-emulator/tests/test_lifecycle.py"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "11.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.14",
    "expo-contacts": "58.0.7",
    "expo-file-system": "58.0.9",
    "expo-image-picker": "58.0.10",
    "expo-location": "58.0.17",
    "expo-notifications": "58.1.5",
    "expo-print": "58.0.6",
    "expo-sharing": "58.0.19",
    "firebase": "13.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-qrcode-svg": "6.3.26",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-print"
        ]
      }
    }
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
