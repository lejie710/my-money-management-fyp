rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function validId(id) { return id.matches('backup-[a-z0-9-]{16,96}'); }
  function hashMetadata() { return request.resource.metadata.keys().hasOnly(['sha256']) && request.resource.metadata.sha256.matches('[a-f0-9]{64}'); }
  match /users/{uid}/walletBackups/{id}/snapshot.json {
   allow read: if owner(uid);
   allow create: if resource == null && owner(uid) && validId(id) && request.resource.size > 0 && request.resource.size <= 5242880 && request.resource.contentType == 'application/json' && hashMetadata();
   allow update: if false;
   allow delete: if owner(uid);
  }
  match /users/{uid}/walletBackups/{id}/photos/{hash} {
   allow read: if owner(uid);
   allow create: if resource == null && owner(uid) && validId(id) && hash.matches('[a-f0-9]{64}') && request.resource.metadata.sha256 == hash && request.resource.size > 0 && request.resource.size <= 10485760 && request.resource.contentType in ['image/jpeg','image/png','image/webp'] && hashMetadata();
   allow update: if false;
   allow delete: if owner(uid);
  }
 }
}
