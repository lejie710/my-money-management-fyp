# Copy selected values into an ignored .env.local at the repository root.
# Client configuration is bundled by Expo. Never put admin/service-account keys here.
# Firebase remains off until your own project or the documented demo emulators are configured.
# When enabled, signed-in ordinary financial saves and explicitly kept photos use Firebase.
# Guest tracking stays local; old device wallets require a separate preview/confirmed copy.
# Manual backup is an additional recovery snapshot, not the everyday-save mechanism.
# Hosted Storage requires Blaze billing; the demo emulator route does not.
# Deploy reviewed Firestore/Storage rules yourself before using a hosted project.
# See tools/firebase-backup/README.md; never use another person's project or credentials.
EXPO_PUBLIC_LOCAL_AUTH_EMULATOR=0
EXPO_PUBLIC_FIREBASE_MODE=off
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Emulator mode additionally requires all three loopback ports.
EXPO_PUBLIC_FIREBASE_AUTH_PORT=19099
EXPO_PUBLIC_FIREBASE_FIRESTORE_PORT=18080
EXPO_PUBLIC_FIREBASE_STORAGE_PORT=19199
