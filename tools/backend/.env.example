# Server-only configuration. Copy outside source control and supply your values.
BACKEND_MODE=hosted
FIREBASE_PROJECT_ID=your-firebase-project
SERVICE_ID=financial-services-v1
LISTEN_HOST=127.0.0.1
PORT=8080
BACKEND_DATA_DIR=/absolute/private/backend-data
# Choose compatible OpenAI Chat Completions structured-output model and key.
OPENAI_MODEL=replace-with-compatible-model
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=
# Prophet is optional; Python must already have the pinned packages installed.
ENABLE_PROPHET=0
PROPHET_PYTHON=/absolute/path/to/python
# Prefer direct TLS. Both files must be readable by the backend account.
TLS_KEY_FILE=
TLS_CERT_FILE=
# Only for private ingress: require an exact trusted peer AND forwarded HTTPS.
TRUSTED_TLS_PROXY=0
TRUSTED_PROXY_PEERS=127.0.0.1,::1,::ffff:127.0.0.1
